<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- com.claude.auto-merge-sweep.plist (llm#1471)
         Runs the Auto-Merge Policy every 30 minutes: bin/auto_merge_sweep.sh
         --apply labels auto-merged and squash-merges PRs that meet ALL the
         policy's conditions, at most 3 per run. Each action is logged to
         ~/.claude/logs/auto_merge_sweep.log.

         NOT LOADED by the change that added it. Only the owner loads it.
         Install:
           cp .claude/launchd/com.claude.auto-merge-sweep.plist ~/Library/LaunchAgents/
           launchctl bootstrap gui/501 ~/Library/LaunchAgents/com.claude.auto-merge-sweep.plist
         Verify:
           launchctl print gui/501/com.claude.auto-merge-sweep
           tail ~/.claude/logs/auto_merge_sweep.log
         Rollback:
           launchctl bootout gui/501/com.claude.auto-merge-sweep
         or, to keep the job but stop merging, delete --apply from
         bin/launchd-recorders/auto-merge-sweep (report mode mutates nothing). -->

    <key>Label</key>
    <string>com.claude.auto-merge-sweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/johngavin/docs_gh/llm/bin/launchd-recorders/auto-merge-sweep</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/johngavin</string>
    </dict>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardInPath</key>
    <string>/dev/null</string>

    <key>StandardOutPath</key>
    <string>/Users/johngavin/.claude/logs/auto_merge_sweep.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/johngavin/.claude/logs/auto_merge_sweep.err</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>

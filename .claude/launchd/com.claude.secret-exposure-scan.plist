<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- com.claude.secret-exposure-scan.plist
         Nightly aggressive secret-exposure scan: whole-environment capture
         patterns in source, plaintext credentials at rest, insecure
         permissions on flagged files, and secrets left in comments.
         See .claude/rules/secret-exposure-scanning.md.

         Runs `--scan --quiet` (report-only), NOT `--fix --quiet`. Day-1
         signal was 615 findings at ~5% precision -- `--fix` chmods every
         Detector-3 hit unattended, and at that precision most of those
         chmods would have landed on build output that should have been
         pruned, not on real credential files. The scanner was tuned
         (pruned .quarto/_freeze/docs/libs/site_libs + *.min.js/*.map,
         added a self-reference exemption, added a fixture-value heuristic
         for test fixtures) but has not yet had a clean week of `--scan`
         output to confirm the remaining findings are the small, real set.
         Promote to `--fix --quiet` once a week of `--scan` runs shows a
         stable, near-zero-noise finding count -- track in the log at
         ~/.claude/logs/secret_exposure_scan.log and the housekeeping
         framework's task inventory.

         Scheduled at 03:40 -- the 00:00-04:00 pre-dawn slot has
         02:00 roborev-metrics-etl, 02:15 roborev-daily-backlog,
         02:30 self-review-stage1, 03:00 unified-duckdb-backup;
         03:40 is a clear gap before those jobs' DB writes and before
         the day's first interactive session.

         Uses the bin/launchd-recorders/secret-exposure-scan named-launcher
         wrapper (llm#1121) so macOS Background Task Management shows
         "secret-exposure-scan" instead of generic "bash" in Login Items.

         Install / reload:
           launchctl bootout gui/$(id -u)/com.claude.secret-exposure-scan 2>/dev/null
           cp .claude/launchd/com.claude.secret-exposure-scan.plist \
              ~/Library/LaunchAgents/
           launchctl bootstrap gui/$(id -u) \
              ~/Library/LaunchAgents/com.claude.secret-exposure-scan.plist

         Manual run:
           .claude/scripts/secret_exposure_scan.sh --scan
           .claude/scripts/secret_exposure_scan.sh --fix
    -->

    <key>Label</key>
    <string>com.claude.secret-exposure-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/johngavin/docs_gh/llm/bin/launchd-recorders/secret-exposure-scan</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/johngavin</string>
    </dict>

    <!-- Daily 03:40 local -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <!-- Prevents SIGTTIN/state-T hang if anything in the chain reads
         stdin while running under launchd (llm#342 lesson). -->
    <key>StandardInPath</key>
    <string>/dev/null</string>

    <key>StandardOutPath</key>
    <string>/Users/johngavin/.claude/logs/secret_exposure_scan.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/johngavin/.claude/logs/secret_exposure_scan.err</string>

    <!-- Do NOT run on load — only on the schedule. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Retry after 60s if the job exits non-zero (findings still
         outstanding after --scan is an expected non-zero exit, not a
         crash — this just re-checks once, it does not loop). -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

</dict>
</plist>

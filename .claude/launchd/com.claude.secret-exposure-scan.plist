<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- com.claude.secret-exposure-scan.plist
         Nightly aggressive secret-exposure scan: whole-environment capture
         patterns in source, plaintext credentials at rest, insecure
         permissions on flagged files, and secrets left in comments.
         Runs `secret_exposure_scan.sh --fix` so the SAFE remediation
         (chmod 600 on a bad-permission credential file) happens
         automatically every night; everything else is report-only and
         needs a human. See .claude/rules/secret-exposure-scanning.md.

         Scheduled at 03:40 -- the 00:00-04:00 pre-dawn slot has
         02:00 roborev-metrics-etl, 02:15 roborev-daily-backlog,
         02:30 self-review-stage1, 03:00 unified-duckdb-backup;
         03:40 is a clear gap before those jobs' DB writes and before
         the day's first interactive session.

         Uses a plain /bin/bash ProgramArguments form (not the per-job
         named-launcher pattern in bin/launchd-recorders/ — llm#866) since
         this dispatch did not touch the launcher generator; a future pass
         MAY migrate this job to a named launcher for Login Items parity
         with the other com.claude.* jobs.

         Install / reload:
           launchctl bootout gui/$(id -u)/com.claude.secret-exposure-scan 2>/dev/null
           cp .claude/launchd/com.claude.secret-exposure-scan.plist \
              ~/Library/LaunchAgents/
           launchctl bootstrap gui/$(id -u) \
              ~/Library/LaunchAgents/com.claude.secret-exposure-scan.plist

         Manual run:
           .claude/scripts/secret_exposure_scan.sh --scan
           .claude/scripts/secret_exposure_scan.sh --fix
    -->

    <key>Label</key>
    <string>com.claude.secret-exposure-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/johngavin/docs_gh/llm/.claude/scripts/secret_exposure_scan.sh</string>
        <string>--fix</string>
        <string>--quiet</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/johngavin</string>
    </dict>

    <!-- Daily 03:40 local -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <!-- Prevents SIGTTIN/state-T hang if anything in the chain reads
         stdin while running under launchd (llm#342 lesson). -->
    <key>StandardInPath</key>
    <string>/dev/null</string>

    <key>StandardOutPath</key>
    <string>/Users/johngavin/.claude/logs/secret_exposure_scan.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/johngavin/.claude/logs/secret_exposure_scan.err</string>

    <!-- Do NOT run on load — only on the schedule. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Retry after 60s if the job exits non-zero (findings still
         outstanding after --fix is an expected non-zero exit, not a
         crash — this just re-checks once, it does not loop). -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.johngavin.chrome-tab-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/johngavin/docs_gh/llm/bin/launchd-recorders/chrome-tab-backup</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/chrome_tab_backup_stderr.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/chrome_tab_backup_stdout.log</string>
	<!-- Staggered 8 min past :00 to avoid clock-minute contention (llm#1154). -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>8</integer>
	</dict>
</dict>
</plist>

#!/bin/bash
# roborev-failure-alert — loud alert on sustained roborev failure so a silent
# outage (like the 74h gemini one, llm#791) can't run undetected.
#
# Detects: (a) daemon down, (b) >= FAIL_DELTA NEW failed jobs since the last
# check (i.e. failures actively accumulating — not a stale 24h count), or
# (c) the daemon process has been up longer than ROBOREV_DAEMON_MAX_AGE_DAYS.
# (a)/(b) are deduped via a state file: alerts once on healthy->failing and
# once on recovery. (c) is visibility only, not a health verdict — see its
# block below for why an automatic restart is deliberately NOT what this does
# (llm#956).
#
# Channel: macOS notification (with sound) + a log line. Runs every 30 min via
# com.johngavin.roborev-failure-alert. Override FAIL_DELTA to tune.
set -uo pipefail

FAIL_DELTA="${ROBOREV_ALERT_FAIL_DELTA:-5}"
STATE="$HOME/.roborev/alert_state"          # "<state> <failed_total> <completed_total>"
LOG="$HOME/.claude/logs/roborev_failure_alert.log"
mkdir -p "$(dirname "$LOG")" "$(dirname "$STATE")" 2>/dev/null

# (c) daemon age — separate state file, own format ("ok"|"old"), so it never
# collides with the 3-field parse of $STATE above.
DAEMON_AGE_STATE="$HOME/.roborev/alert_state_daemon_age"
DAEMON_MAX_AGE_DAYS="${ROBOREV_DAEMON_MAX_AGE_DAYS:-7}"

SIGNAL_URL="http://localhost:7583/api/v1/rpc"

# Overridable for tests (never touch the real machine when set):
ROBOREV_BIN="${ROBOREV_BIN:-/usr/local/bin/roborev}"
OSASCRIPT_BIN="${OSASCRIPT_BIN:-osascript}"

log()  { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

# Signal account number — read at runtime, NEVER hardcoded (llm#946). A git
# history rewrite replaced the real value with a fictional placeholder
# across all history after it was exposed in this public repo for four
# months. Accept an already-exported SIGNAL_ACCOUNT (e.g. set by the
# `with-secrets` wrapper) or source SECRETS_ENV_FILE directly when invoked
# without it — this script runs via launchd, which does not source shell rc
# files. Same override convention as render_signal_launchd_plists.sh.
SECRETS_ENV_FILE="${SECRETS_ENV_FILE:-$HOME/.config/secrets.env}"
if [ -z "${SIGNAL_ACCOUNT:-}" ] && [ -r "$SECRETS_ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$SECRETS_ENV_FILE"
  set +a
fi
if [ -z "${SIGNAL_ACCOUNT:-}" ]; then
  log "FATAL: SIGNAL_ACCOUNT is unset/empty -- refusing to run against an unknown Signal account. Set it in $SECRETS_ENV_FILE (llm#946)."
  exit 1
fi

signal(){ curl -s -m 5 -X POST "$SIGNAL_URL" -H "Content-Type: application/json" \
            -d "{\"jsonrpc\":\"2.0\",\"method\":\"send\",\"params\":{\"account\":\"$SIGNAL_ACCOUNT\",\"recipient\":[\"$SIGNAL_ACCOUNT\"],\"message\":\"$1\"},\"id\":1}" >/dev/null 2>&1 || true; }
# note(): local macOS notification (at-machine) + Signal note-to-self (away-from-machine).
note() { command -v "$OSASCRIPT_BIN" >/dev/null 2>&1 && \
           "$OSASCRIPT_BIN" -e "display notification \"$2\" with title \"$1\" sound name \"$3\"" >/dev/null 2>&1 || true
         signal "$1: $2"; }

status="$("$ROBOREV_BIN" status 2>/dev/null)"
read -r pstate pfail pcomp <<EOF
$(cat "$STATE" 2>/dev/null || echo "ok 0 0")
EOF
pfail="${pfail:-0}"; pcomp="${pcomp:-0}"; pstate="${pstate:-ok}"

# (a) daemon down
if [ -z "$status" ] || printf '%s' "$status" | grep -qiE "not running|connection refused"; then
  if [ "$pstate" != "failing" ]; then
    log "ALERT: daemon not running"
    # NOTE (llm#956): do NOT tell anyone to run `roborev daemon start` — that
    # self-daemonizes again, which is the exact failure mode this migration
    # removed. Once com.roborev.daemon is installed, launchd owns restarts.
    note "roborev DOWN" "Daemon not running — no reviews. Check: launchctl print gui/\$(id -u)/com.roborev.daemon" "Basso"
    echo "roborev-failure-alert: ALERT — daemon down"
  fi
  printf 'failing %s %s\n' "$pfail" "$pcomp" > "$STATE"
  exit 0
fi

# (c) daemon age — visibility only, never an automatic restart. Bounding
# unattended runtime this way is deliberately NOT how this metric works:
# a scheduled restart would erase evidence of exactly the incident it exists
# to catch (llm#936 — 7 days on a stale GEMINI_API_KEY, invisible the whole
# time). This block only reports; a human decides whether to
# `launchctl kickstart` it, e.g. because a secret rotated since it started.
daemon_pid="$(pgrep -f 'roborev daemon run' 2>/dev/null | head -1)"
if [ -n "$daemon_pid" ]; then
  daemon_etime="$(ps -o etime= -p "$daemon_pid" 2>/dev/null | tr -d ' ')"
  # ps etime is [[dd-]hh:]mm:ss -- pull the leading day count if present,
  # else the process is under a day old (0).
  daemon_age_days=0
  case "$daemon_etime" in
    *-*) daemon_age_days="${daemon_etime%%-*}" ;;
  esac
  prev_age_state="$(cat "$DAEMON_AGE_STATE" 2>/dev/null || echo "ok")"
  if [ -n "$daemon_age_days" ] && [ "$daemon_age_days" -ge "$DAEMON_MAX_AGE_DAYS" ] 2>/dev/null; then
    if [ "$prev_age_state" != "old" ]; then
      log "ALERT: roborev daemon pid=$daemon_pid up ${daemon_age_days}d (>= ${DAEMON_MAX_AGE_DAYS}d threshold) -- if a secret rotated since it started, it is running stale"
      note "roborev daemon aging" "Up ${daemon_age_days}d (pid $daemon_pid). If a secret rotated since, restart: launchctl kickstart -k gui/\$(id -u)/com.roborev.daemon" "Glass"
      echo "roborev-failure-alert: daemon age ${daemon_age_days}d >= threshold ${DAEMON_MAX_AGE_DAYS}d (pid $daemon_pid)"
    fi
    echo "old" > "$DAEMON_AGE_STATE"
  else
    [ "$prev_age_state" = "old" ] && log "daemon age back under threshold (now ${daemon_age_days}d, pid $daemon_pid) -- restarted since last check"
    echo "ok" > "$DAEMON_AGE_STATE"
  fi
else
  log "warn: roborev status reports running but no PID matched 'roborev daemon run' -- pre-migration self-daemonized process, or ps -f pattern mismatch"
fi

fail="$(printf '%s' "$status" | grep -oE '[0-9]+ failed'    | grep -oE '^[0-9]+')"; fail="${fail:-0}"
comp="$(printf '%s' "$status" | grep -oE '[0-9]+ completed' | grep -oE '^[0-9]+')"; comp="${comp:-0}"
dfail=$(( fail - pfail )); [ "$dfail" -lt 0 ] && dfail=0

# First run: establish baseline, no alert.
if [ "$pfail" -eq 0 ] && [ "$pcomp" -eq 0 ]; then
  log "init: baseline failed=$fail completed=$comp"
  printf 'ok %s %s\n' "$fail" "$comp" > "$STATE"
  exit 0
fi

# (b) new failures accumulating
if [ "$dfail" -ge "$FAIL_DELTA" ]; then
  if [ "$pstate" != "failing" ]; then
    log "ALERT: $dfail new failures since last check (failed total=$fail)"
    note "roborev FAILING" "$dfail new review failures. Check: roborev check-agents" "Basso"
    echo "roborev-failure-alert: ALERT — $dfail new failures"
  else
    log "still failing: +$dfail new (total=$fail)"
  fi
  printf 'failing %s %s\n' "$fail" "$comp" > "$STATE"
else
  if [ "$pstate" = "failing" ]; then
    log "RECOVERED: no new failures (+$dfail); healthy"
    note "roborev recovered" "Reviews healthy again." "Glass"
    echo "roborev-failure-alert: recovered"
  fi
  printf 'ok %s %s\n' "$fail" "$comp" > "$STATE"
fi

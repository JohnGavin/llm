+#' Compute a rate as a fraction of total
+#'
+#' @param numerator Numeric count.
+#' @param denominator Numeric total.
+#' @return Numeric rate.
+#' @export
+compute_rate <- function(numerator, denominator) {
+  # No guard against denominator == 0: silently returns Inf/NaN and
+  # propagates undetected into downstream aggregation.
+  numerator / denominator
+}

+++ b/tests/testthat/test-filter_helpers.R
@@ -0,0 +1,7 @@
+test_that("keep_completed keeps only completed jobs", {
+  jobs <- data.frame(status = c("completed", "pending", "completed"))
+  result <- keep_completed(jobs)
+  # BUG: asserts 1 row remains ("pending") -- this matches the inverted
+  # filter's (wrong) behavior instead of the function's stated intent.
+  expect_equal(nrow(result), 1)
+})
